# GitLab configuration
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
# gitlab.com/<GITLAB_USER>/<GITLAB_REPOSITORY_NAME>.git
GITLAB_USER=
GITLAB_REPOSITORY_NAME=

# GitHub configuration
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOSITORY_NAME=

###> Texts added at the top of imported issues/PRs ###
# Available placeholders: {date} {iid} {url}. Use \n for a line break.
# Set the value to "" (empty) to add no header (only original description).
GITHUB_ISSUE_BODY_HEADER="**Created on GitLab:** {date}\n**GitLab Issue:** [#{iid}]({url})\n\n"
GITHUB_MR_BODY_HEADER="**Created on GitLab:** {date}\n**GitLab MR:** [!{iid}]({url})\n\n"

# How the {date} placeholder is displayed.
# Timezone: any PHP timezone (e.g. UTC, America/New_York). Format: PHP date() syntax.
GITHUB_BODY_DATE_TIMEZONE=Europe/Paris
GITHUB_BODY_DATE_FORMAT="d/m/Y H:i:s"

# GitHub username assigned to issues/PRs that had an assignee on GitLab.
# Leave empty to assign them to the authenticated user (GITHUB_USERNAME).
GITHUB_ASSIGNEE=
